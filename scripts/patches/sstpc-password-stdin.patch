--- a/src/sstp-option.c
+++ b/src/sstp-option.c
@@ -196,6 +196,34 @@
         break;
 
     case 7: 
+        /* "-": read the password from stdin, so it never shows up on the
+         * command line (changed by SSTP Client, sstp-mac-client, 2026-11-04) */
+        if (strcmp(optarg, "-") == 0)
+        {
+            char buf[256];
+            volatile char *wipe = buf;
+            size_t len;
+
+            if (!fgets(buf, sizeof(buf), stdin))
+            {
+                fprintf(stderr, "Could not read the password from standard input\n");
+                exit(EXIT_FAILURE);
+            }
+            len = strcspn(buf, "\r\n");
+            buf[len] = '\0';
+            if (len == 0)
+            {
+                fprintf(stderr, "The password from standard input is empty\n");
+                exit(EXIT_FAILURE);
+            }
+            ctx->password = strdup(buf);
+            /* volatile: the compiler may not drop the wipe of a dead buffer */
+            for (len = 0; len < sizeof(buf); len++)
+            {
+                wipe[len] = '\0';
+            }
+            break;
+        }
         ctx->password = strdup(optarg);
         sstp_scramble(optarg);
         break;
